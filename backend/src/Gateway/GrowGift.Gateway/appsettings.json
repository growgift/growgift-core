{
  "ReverseProxy": {
    "Routes": {
      "identity": { "ClusterId": "identity", "Match": { "Path": "/api/v1/auth/{**rest}" } },
      "billing": { "ClusterId": "identity", "Match": { "Path": "/api/v1/billing/{**rest}" } },
      "catalog": { "ClusterId": "catalog", "Match": { "Path": "/api/v1/collections/{**rest}" } },
      "orders": { "ClusterId": "gifting", "Match": { "Path": "/api/v1/orders/{**rest}" } },
      "gifts": { "ClusterId": "gifting", "Match": { "Path": "/api/v1/gifts/{**rest}" } },
      "gifting-webhooks": { "ClusterId": "gifting", "Match": { "Path": "/api/v1/webhooks/{**rest}" } },
      "family-children": { "ClusterId": "family", "Match": { "Path": "/api/v1/children/{**rest}" } },
      "family-tasks": { "ClusterId": "family", "Match": { "Path": "/api/v1/tasks/{**rest}" } },
      "family-partners": { "ClusterId": "family", "Match": { "Path": "/api/v1/partners/{**rest}" } },
      "family-tree": { "ClusterId": "family", "Match": { "Path": "/api/v1/family" } },
      "family-me": { "ClusterId": "family", "Match": { "Path": "/api/v1/me/{**rest}" } },
      "shipments": { "ClusterId": "fulfillment", "Match": { "Path": "/api/v1/shipments/{**rest}" } },
      "shipping": { "ClusterId": "fulfillment", "Match": { "Path": "/api/v1/shipping/{**rest}" } },
      "onboarding": { "ClusterId": "brokerage", "Match": { "Path": "/api/v1/onboarding/{**rest}" } },
      "portfolio": { "ClusterId": "brokerage", "Match": { "Path": "/api/v1/portfolio" } },
      "trading": { "ClusterId": "brokerage", "Match": { "Path": "/api/v1/trading/{**rest}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5001" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://localhost:5002" } } },
      "gifting": { "Destinations": { "d1": { "Address": "http://localhost:5003" } } },
      "family": { "Destinations": { "d1": { "Address": "http://localhost:5005" } } },
      "fulfillment": { "Destinations": { "d1": { "Address": "http://localhost:5006" } } },
      "brokerage": { "Destinations": { "d1": { "Address": "http://localhost:5004" } } }
    }
  }
}
